# Which ApiClient implementation the app boots with.
#   mock -> MockApiClient  (seeded fixtures, no backend needed)
#   http -> HttpApiClient  (talks to EXPO_PUBLIC_API_URL)
EXPO_PUBLIC_API_MODE=mock

# Base URL of the incident reporting backend. Required when API_MODE=http.
EXPO_PUBLIC_API_URL=https://698zp0x7-8000.uks1.devtunnels.ms

# Artificial latency (ms) and failure rate (0..1) injected by MockApiClient so
# loading and error states are exercisable without a backend.
EXPO_PUBLIC_MOCK_LATENCY_MS=450
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
