# Which ApiClient implementation the app boots with.
#   mock -> MockApiClient  (seeded fixtures, no backend needed)
#   http -> HttpApiClient  (talks to EXPO_PUBLIC_API_URL)
EXPO_PUBLIC_API_MODE=mock

# Base URL of the incident reporting backend. Required when API_MODE=http.
EXPO_PUBLIC_API_URL=https://698zp0x7-8000.uks1.devtunnels.ms

# Artificial latency (ms) and failure rate (0..1) injected by MockApiClient so
# loading and error states are exercisable without a backend.
EXPO_PUBLIC_MOCK_LATENCY_MS=450
EXPO_PUBLIC_MOCK_FAILURE_RATE=0

# ─── Continue with Google ───────────────────────────────────────────────────
#
# OAuth client ids from the Google Cloud console, for THIS app. They cannot be
# committed or guessed, and until the web one is set the "Continue with Google"
# button does not render at all — a button that opens a picker and then fails on
# an empty audience is worse than no button, because nobody can tell that apart
# from their account being refused.
#
# WEB is required on every platform: it is the audience the id token is issued
# for, and the backend verifies that audience. Not "the web build".
#
# IOS is the iOS OAuth client. Its reversed form also goes in app.json, under
# the google-signin plugin as `iosUrlScheme`
# (com.googleusercontent.apps.<the id, reversed>), or the callback never returns.
#
# Android needs its own OAuth client registered against the app's signing
# certificate, but it is never named here — Google matches it by signature.
#
# Needs a development build. The native module is absent from Expo Go.
#
# THE PLUGIN IS NOT IN app.json, deliberately. `@react-native-google-signin`'s
# config plugin throws without `iosUrlScheme`, so the bare entry `expo install`
# adds fails every prebuild and every EAS build. Add it back once you have the
# iOS client id, complete:
#
#   ["@react-native-google-signin/google-signin",
#     { "iosUrlScheme": "com.googleusercontent.apps.<ios client id, reversed>" }]
#
# `src/features/auth/__tests__/googleSignIn.test.ts` fails if it is added
# without that, which is the build break with a symptom attached.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
