{
  "expo": {
    "name": "GhanaMediaWatch",
    "slug": "ghanamediawatch",
    "scheme": "ghanamediawatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F4F5FA",
    "splash": {
      "backgroundColor": "#F4F5FA",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "gh.mediawatch.app",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "processing", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "GhanaMediaWatch uses the camera to capture photo and video evidence of incidents.",
        "NSMicrophoneUsageDescription": "GhanaMediaWatch records audio with incident videos so the footage carries its original context.",
        "NSLocationWhenInUseUsageDescription": "GhanaMediaWatch needs your precise location to stamp incident reports with accurate GPS coordinates. The camera only unlocks once an accurate fix is acquired.",
        "NSPhotoLibraryAddUsageDescription": "GhanaMediaWatch can save a copy of the footage you capture to your photo library."
      }
    },
    "android": {
      "package": "gh.mediawatch.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#F4F5FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      "expo-video",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GhanaMediaWatch needs your precise location to stamp incident reports with accurate GPS coordinates. The camera only unlocks once an accurate fix is acquired.",
          "locationWhenInUsePermission": "GhanaMediaWatch needs your precise location to stamp incident reports with accurate GPS coordinates. The camera only unlocks once an accurate fix is acquired.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B3DF5",
          "defaultChannel": "incident-alerts"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GhanaMediaWatch uses the camera to capture photo and video evidence of incidents.",
          "microphonePermission": "GhanaMediaWatch records audio with incident videos so the footage carries its original context.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
